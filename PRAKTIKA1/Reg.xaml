<Window x:Class="PRAKTIKA1.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация — RED LEASING"
        Height="700" Width="420"
        Background="#0d0d0d"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <!-- HEADER -->
        <DockPanel VerticalAlignment="Top" Height="60" Background="#1a1a1a">
            <TextBlock Text="RED" Foreground="White"
                       FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="15,0,0,0"/>
            <TextBlock Text="LEASING" Foreground="#e10600"
                       FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Главная" Foreground="White" Background="Transparent" BorderBrush="{x:Null}" Margin="10"/>
                <Button Content="Каталог" Foreground="White" Background="Transparent" BorderBrush="{x:Null}" Margin="10"/>
                <Button Content="Вход" Foreground="White" Background="Transparent" BorderBrush="{x:Null}" Margin="10"/>
                <Button Content="Регистрация" Foreground="#e10600" Background="Transparent" BorderBrush="{x:Null}" Margin="10"/>
            </StackPanel>
        </DockPanel>

        <!-- FORM -->
        <Border Width="360"
        Background="#1a1a1a"
        BorderBrush="#2a2a2a"
        BorderThickness="1,3,1,1"
        CornerRadius="12"
        Padding="20">

            <StackPanel>

                <TextBlock Text="Регистрация"
                           FontSize="22"
                           Foreground="White"
                           FontWeight="Bold"/>

                <TextBlock Text="Создайте аккаунт, чтобы оформить лизинг"
                           FontSize="12"
                           Foreground="#8a8a8a"
                           Margin="0,5,0,15"/>

                <TextBlock Text="Имя" Foreground="#8a8a8a"/>
                <TextBox x:Name="NameBox" />

                <TextBlock Text="Фамилия" Foreground="#8a8a8a" Margin="0,10,0,0"/>
                <TextBox x:Name="SecondNameBox"/>

                <TextBlock Text="Телефон" Foreground="#8a8a8a" Margin="0,10,0,0"/>
                <TextBox x:Name="PhoneBox"/>

                <TextBlock Text="E-mail" Foreground="#8a8a8a" Margin="0,10,0,0"/>
                <TextBox x:Name="EmailBox"/>

                <TextBlock Text="Пароль" Foreground="#8a8a8a" Margin="0,10,0,0"/>
                <PasswordBox x:Name="PasswordBox"/>

                <Button Content="Зарегистрироваться"
                        Background="#e10600"
                        Foreground="White"
                        FontWeight="Bold"
                        Margin="0,20,0,0"
                        Height="40"
                        Click="Register_Click"/>

                <TextBlock x:Name="MsgText"
                           Text=""
                           Foreground="#e10600"
                           Margin="0,10,0,0"
                           TextAlignment="Center"/>

                <TextBlock Text="Уже есть аккаунт? Войти"
                           Foreground="#8a8a8a"
                           Margin="0,15,0,0"
                           TextAlignment="Center"
                           Cursor="Hand"
                           MouseDown="GoLogin_Click"/>

            </StackPanel>
        </Border>

    </Grid>
</Window>